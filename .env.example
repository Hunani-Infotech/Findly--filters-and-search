# Shopify (from Partner Dashboard / `shopify app env` — never commit real values)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_files,write_files,read_inventory,read_locations,read_content,read_markets
# Production: HOST and SHOPIFY_APP_URL = your public HTTPS app origin
SHOPIFY_APP_URL=https://localhost
SHOPIFY_FLAG_STORE=your-dev-store.myshopify.com

# PostgreSQL — Supabase (current). Never commit real URIs.
# Copy both strings from Dashboard → Connect → ORMs → Prisma.
# DATABASE_URL = transaction pooler (port 6543). DIRECT_URL = session pooler (port 5432).
# Do NOT use db.PROJECT_REF.supabase.co — that host is IPv6-only and Prisma P1001s on IPv4 networks.
# Username is postgres.PROJECT_REF (not postgres). Encode @ in the password as %40.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Local rollback (embedded Postgres from `npm run dev`):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_filter?schema=public

# Host-only Cloudflare Tunnel hostname for shared *local* Postgres (no token here)
SHARE_DB_HOSTNAME=

# Redis / BullMQ
# Upstash (TLS): rediss://default:<password>@<host>:<port>
# Local (no TLS): redis://localhost:6379
REDIS_URL=redis://localhost:6379
# BullMQ parallel job slots (one process). Default 2. Cap 32.
# Same Hostinger/web process runs the worker in-process — set this to use your CPU.
WORKER_COUNT=2
# Leave unset so in-process worker starts with the web app. Set 0 only to disable.
# START_WORKER=0

# Billing — must be false for real App Store charges (default is false if unset)
BILLING_TEST_MODE=false

# Optional: unlock detailed /health JSON (postgres/redis/worker). Without this,
# production /health returns only { "ok": true|false }. Pass via header
# X-Health-Token or ?token=
# HEALTH_CHECK_TOKEN=

# Contact form → Gmail. Only these two are required.
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Do not set SMTP_HOST / SMTP_USER / SMTP_PASSWORD / SMTP_PORT for Gmail.
# The app uses: smtp.gmail.com, port 465, user+from+to = GMAIL_USER

# Optional
SHOP_CUSTOM_DOMAIN=
PORT=3000
# Local only: skip App Proxy HMAC checks
PROXY_SIGNATURE_BYPASS=false

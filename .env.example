# Shopify (from Partner Dashboard / `shopify app env` — never commit real values)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_files,write_files,read_inventory,read_locations,read_content,read_markets,read_metaobjects
# Production: HOST and SHOPIFY_APP_URL = your public HTTPS app origin
SHOPIFY_APP_URL=https://localhost
SHOPIFY_FLAG_STORE=your-dev-store.myshopify.com

# App environment — controls Shopify CLI config + Vite tunnel hosts.
# development → shopify.app.development.toml (Update URLs: Yes / Cloudflare tunnel)
# production  → shopify.app.toml (Hostinger URLs; use on Hostinger + `npm run deploy`)
# Default: development locally; production when NODE_ENV=production.
APP_ENV=development

# Demo-store catalog seed (npm run seed:catalog) — custom app token with
# write_products + write_files. Do NOT put write_products on Findly's App Store scopes.
# SEED_ADMIN_API_TOKEN=shpat_…
# SEED_SHOP=your-dev-store.myshopify.com

# PostgreSQL — Supabase (Hostinger production standard).
# Prefer hPanel → Node.js app → Database → Connect → Supabase (sets env for you).
# Or paste BOTH strings from Supabase → Connect → ORMs → Prisma:
#
# DATABASE_URL = Transaction pooler (port 6543, IPv4). Required on Hostinger.
# DIRECT_URL   = Session pooler (port 5432, IPv4) for migrations — NOT db.*.supabase.co
#                (direct host is IPv6-only and fails from Hostinger).
#
# Username is postgres.PROJECT_REF. Encode @ in the password as %40.
# App adds pgbouncer=true, sslmode=require, connect_timeout=30 if missing.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30&connection_limit=5
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connect_timeout=30

# Local rollback (embedded Postgres from `npm run dev`):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_filter?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/smart_filter?schema=public

# Host-only Cloudflare Tunnel hostname for shared *local* Postgres (no token here)
SHARE_DB_HOSTNAME=

# Postgres queue worker (replaces Redis/BullMQ)
# Parallel job slots (one process). Default 2. Cap 32.
# Same Hostinger/web process can poll the queue in-process — set this to use your CPU.
WORKER_COUNT=2
# Leave unset so in-process worker starts with the web app. Set 0 only to disable.
# START_WORKER=0
# Dedicated worker cron: QUEUE_POLL_ONCE=1 drains one batch then exits.
# QUEUE_POLL_ONCE=1

# Billing — must be false for real App Store charges (default is false if unset)
BILLING_TEST_MODE=false

# Optional: unlock detailed /health JSON (postgres/worker). Empty keeps
# production /health at { "ok": true|false }. Pass via X-Health-Token or ?token=
HEALTH_CHECK_TOKEN=

# Contact form. GMAIL_USER is the SMTP login; SUPPORT_EMAIL is the inbox.
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=info@srhwebagency.com
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL=info@srhwebagency.com
# Do not set SMTP_HOST / SMTP_USER / SMTP_PASSWORD / SMTP_PORT for Gmail.
# The app uses: smtp.gmail.com, port 465, user = GMAIL_USER, to = SUPPORT_EMAIL

# Optional
SHOP_CUSTOM_DOMAIN=
PORT=3000
# Local only: skip App Proxy HMAC checks. Ignored unless NODE_ENV=development.
PROXY_SIGNATURE_BYPASS=false
# Local only: unlock billing/plan limits. Must stay false on Hostinger/production.
DEV_UNLOCK_LIMITS=false
# Server storefront route timing logs (off by default). UI timing is browser [FindlyUI] only.
# STOREFRONT_TIMING=1
# Hostinger / `npm start` should run with NODE_ENV=production (server.js sets
# this if unset). Never leave PROXY_SIGNATURE_BYPASS=true or DEV_UNLOCK_LIMITS=true
# on the public host.

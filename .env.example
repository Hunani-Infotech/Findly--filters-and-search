# Shopify (from Partner Dashboard / `shopify app env` — never commit real values)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,read_files,write_files,read_inventory,read_locations,read_content,read_markets
SHOPIFY_APP_URL=https://localhost
SHOPIFY_FLAG_STORE=findly-test-store.myshopify.com

# PostgreSQL — Supabase (current). Never commit real URIs.
# DATABASE_URL = pooled (port 6543). DIRECT_URL = direct (port 5432).
# Encode @ in the password as %40.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Local rollback (embedded Postgres from `npm run dev`):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_filter?schema=public

# Host-only Cloudflare Tunnel hostname for shared *local* Postgres (no token here)
SHARE_DB_HOSTNAME=appdb.hunaniinfotech.com

# Redis / BullMQ
# Upstash (TLS): rediss://default:<password>@<host>:<port>
# Local (no TLS): redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Billing
BILLING_TEST_MODE=true

# Contact form → Gmail (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: send to a different inbox than GMAIL_USER
# SUPPORT_EMAIL=

# Later: cPanel SMTP instead of Gmail (leave GMAIL_* empty)
# SUPPORT_EMAIL=support@hunaniinfotech.com
# SMTP_HOST=mail.hunaniinfotech.com
# SMTP_USER=support@hunaniinfotech.com
# SMTP_PASSWORD=
# SMTP_PORT=587

# Optional
SHOP_CUSTOM_DOMAIN=
PORT=3000
# Local only: skip App Proxy HMAC checks
PROXY_SIGNATURE_BYPASS=false

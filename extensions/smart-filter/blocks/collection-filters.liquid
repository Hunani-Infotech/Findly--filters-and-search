<div
  id="smart-filter-root"
  class="smart-filter smart-filter--{{ block.settings.position }}"
  data-collection-id="{{ collection.id }}"
  data-proxy-base="/apps/smart-filter"
  data-position="{{ block.settings.position }}"
  data-show-counts="{% if block.settings.show_counts %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  <div class="smart-filter__title">{{ block.settings.heading }}</div>
  <div class="smart-filter__facets" data-facets></div>
  <div class="smart-filter__status" data-status aria-live="polite"></div>
</div>

{% schema %}
{
  "name": "t:blocks.collection_filters.name",
  "target": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "stylesheet": "smart-filter.css",
  "javascript": "smart-filter.js",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:blocks.collection_filters.settings.heading.label",
      "default": "Filter products"
    },
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.collection_filters.settings.position.label",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.collection_filters.settings.position.options.left"
        },
        {
          "value": "right",
          "label": "t:blocks.collection_filters.settings.position.options.right"
        },
        {
          "value": "top",
          "label": "t:blocks.collection_filters.settings.position.options.top"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "t:blocks.collection_filters.settings.show_counts.label",
      "default": true
    }
  ]
}
{% endschema %}

<div
  id="smart-filter-root"
  class="smart-filter smart-filter--{{ block.settings.position }}"
  data-collection-id="{% if template contains 'collection' %}{{ collection.id }}{% endif %}"
  data-search-query="{% if template contains 'search' %}{{ search.terms | default: request.params.q | escape }}{% endif %}"
  data-proxy-base="/apps/smart-filter"
  data-position="{{ block.settings.position }}"
  data-show-counts="{% if block.settings.show_counts %}true{% else %}false{% endif %}"
  {{ block.shopify_attributes }}
>
  <button
    type="button"
    class="smart-filter__toggle"
    data-drawer-toggle
    aria-expanded="false"
    aria-controls="smart-filter-panel"
  >
    {{ "blocks.collection_filters.filter" | t }}
    <span class="smart-filter__toggle-count" data-drawer-count hidden></span>
  </button>
  <div class="smart-filter__backdrop" data-drawer-backdrop hidden></div>
  <div
    class="smart-filter__panel"
    id="smart-filter-panel"
    data-drawer-panel
    role="dialog"
    aria-modal="true"
    aria-labelledby="smart-filter-title"
  >
    <div class="smart-filter__panel-head">
      <div class="smart-filter__title" id="smart-filter-title" data-title>Filter:</div>
      <button
        type="button"
        class="smart-filter__close"
        data-drawer-close
        aria-label="{{ "blocks.collection_filters.close" | t }}"
      >
        ×
      </button>
    </div>
    <div class="smart-filter__facets" data-facets></div>
    <div class="smart-filter__status" data-status aria-live="polite"></div>
  </div>
</div>

{% schema %}
{
  "name": "t:blocks.collection_filters.name",
  "target": "section",
  "enabled_on": {
    "templates": ["collection", "search"]
  },
  "stylesheet": "smart-filter.css",
  "javascript": "smart-filter.js",
  "settings": [
    {
      "type": "select",
      "id": "position",
      "label": "t:blocks.collection_filters.settings.position.label",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.collection_filters.settings.position.options.left"
        },
        {
          "value": "right",
          "label": "t:blocks.collection_filters.settings.position.options.right"
        },
        {
          "value": "top",
          "label": "t:blocks.collection_filters.settings.position.options.top"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_counts",
      "label": "t:blocks.collection_filters.settings.show_counts.label",
      "default": true
    }
  ]
}
{% endschema %}

<script src="{{ 'smart-filter-dom.min.js' | asset_url }}" defer></script>
<div
  class="smart-filter-search"
  data-proxy-base="/apps/smart-filter"
  data-show-images="{% if block.settings.show_images %}true{% else %}false{% endif %}"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-company-location="{% if customer.current_location %}{{ customer.current_location.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <form class="sf-search-form" data-search-form role="search">
    <label class="sf-search-label vis-hidden" for="smart-filter-search-q-{{ block.id }}">
      Search products
    </label>
    <div class="sf-search-row">
      <input
        id="smart-filter-search-q-{{ block.id }}"
        class="sf-search-input"
        type="search"
        name="q"
        autocomplete="off"
        enterkeyhint="search"
        data-search-input
        placeholder="{{ block.settings.placeholder | escape }}"
      >
      <button class="sf-search-submit" type="submit" data-search-submit>
        Search
      </button>
    </div>
  </form>
  <div class="sf-search-status" data-status aria-live="polite"></div>
  <div
    class="sf-search-empty"
    data-empty
    role="status"
    hidden
  >
    <p class="sf-search-empty-heading">No products found</p>
    <p class="sf-search-empty-text">Your search did not match any products.</p>
    <button type="button" class="sf-search-clear" data-clear-query>
      Clear query
    </button>
  </div>
  <p class="sf-search-suggest-heading" data-suggest-heading hidden>Suggested</p>
  <ul class="sf-search-results sf-search-suggestions" data-suggestions role="list" hidden></ul>
  <ul class="sf-search-results sf-search-collections" data-suggest-collections role="list" hidden></ul>
  <ul class="sf-search-results" data-results role="list"></ul>
</div>

{% schema %}
{
  "name": "t:blocks.product_search.name",
  "target": "section",
  "enabled_on": {
    "templates": ["search"],
    "groups": ["header"]
  },
  "stylesheet": "smart-filter-search.css",
  "javascript": "smart-filter-search.min.js",
  "settings": [
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:blocks.product_search.settings.placeholder.label",
      "default": "Search products"
    },
    {
      "type": "checkbox",
      "id": "show_images",
      "label": "t:blocks.product_search.settings.show_images.label",
      "default": true
    }
  ]
}
{% endschema %}

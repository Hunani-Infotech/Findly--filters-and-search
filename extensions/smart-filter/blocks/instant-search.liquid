<div
  class="findly-instant"
  data-proxy-base="/apps/smart-filter"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-company-location="{% if customer.current_location %}{{ customer.current_location.id }}{% endif %}"
  hidden
  {{ block.shopify_attributes }}
></div>

{% comment %}
  Hidden from Theme Editor App embeds until app-data metafield
  findly.instant_search_embed is true. Instant search overlays the
  theme header search input — it does not render its own bar.
  Collection listing search is enableCollectionSearch in app Settings.
  Restore later: set that metafield to true, or remove available_if.
{% endcomment %}
{% schema %}
{
  "name": "t:blocks.instant_search.name",
  "target": "body",
  "stylesheet": "instant-search.css",
  "javascript": "instant-search.js",
  "available_if": "{{ app.metafields.findly.instant_search_embed }}",
  "settings": []
}
{% endschema %}

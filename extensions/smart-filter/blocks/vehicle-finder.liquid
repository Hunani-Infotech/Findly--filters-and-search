<script src="{{ 'smart-filter-dom.min.js' | asset_url }}" defer></script>
<div
  class="smart-filter-ymm"
  data-ymm-root
  data-proxy-base="/apps/smart-filter"
  data-locale="{{ request.locale.iso_code }}"
  data-country="{{ localization.country.iso_code }}"
  data-currency="{{ cart.currency.iso_code }}"
  data-company-location="{% if customer.current_location %}{{ customer.current_location.id }}{% endif %}"
  {{ block.shopify_attributes }}
>
  <h2 class="sf-ymm-heading" data-ymm-heading></h2>
  <label class="sf-ymm-input-label vis-hidden" for="smart-filter-ymm-q-{{ block.id }}">
    Search
  </label>
  <input
    id="smart-filter-ymm-q-{{ block.id }}"
    class="sf-ymm-input"
    type="search"
    data-ymm-q
    placeholder="Search"
    autocomplete="off"
    hidden
  >
  <div class="sf-ymm-fields" data-ymm-fields></div>
  <button type="button" class="sf-ymm-search" data-ymm-search>
    SEARCH
  </button>
  <div class="sf-ymm-status" data-ymm-status aria-live="polite"></div>
  <ul class="sf-ymm-results" data-ymm-results role="list"></ul>
</div>

{% schema %}
{
  "name": "t:blocks.vehicle_finder.name",
  "target": "section",
  "enabled_on": {
    "templates": [
      "index",
      "product",
      "collection",
      "page",
      "search",
      "cart",
      "blog",
      "article"
    ]
  },
  "stylesheet": "vehicle-finder.css",
  "javascript": "vehicle-finder.js",
  "settings": []
}
{% endschema %}

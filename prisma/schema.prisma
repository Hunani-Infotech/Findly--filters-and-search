// Findly: Smart Filters & Search — Prisma schema (PostgreSQL, multi-tenant)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Required by @shopify/shopify-app-session-storage-prisma (offline tokens live here).
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SyncStatus {
  PENDING
  SYNCING
  READY
  ERROR
}

enum MetafieldFilterType {
  LIST
  RANGE
  BOOLEAN
}

enum MetafieldOwnerType {
  PRODUCT
  VARIANT
}

/// Tenant root. Access tokens are referenced via Session.shop == Shop.domain (not duplicated).
model Shop {
  id            String    @id @default(cuid())
  domain        String    @unique
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  /// Denormalized plan label (kept in sync with Subscription / PLANS)
  plan          String    @default("free")

  filterConfigs         FilterConfig[]
  metafieldMappings     MetafieldMapping[]
  syncJob               SyncJob?
  subscription          Subscription?
  settings              AppSettings?
  /// Catalog index (supports collection filter queries)
  products              ProductFacet[]
  memberships           CollectionMembership[]
  collections           Collection[]
  discoveredMetafields  DiscoveredMetafield[]
}

/// Merchant app/widget settings (admin Settings screen).
model AppSettings {
  id               String  @id @default(cuid())
  shopId           String  @unique
  shop             Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
  widgetPosition    String  @default("left") // left | right | top
  accentColor       String  @default("#1c1917")
  showProductCounts Boolean @default(true)
  collapseByDefault Boolean @default(false)
  /// show | hide | hide_after_filter (Globo out-of-stock display)
  hideOutOfStock    String  @default("show")
  widgetShadow      Boolean @default(true)
  widgetRadius      Int     @default(12)
  /// theme | heading | body | custom
  widgetFontMode    String  @default("theme")
  widgetFontFamily  String  @default("")
  widgetTitle       String  @default("Filter:")
  widgetTitleSize   Int     @default(16)
  widgetTitleColor  String  @default("#1c1917")
  /// Ordered searchable fields, e.g. ["title","vendor","productType","tags"]
  searchFields      String[] @default(["title", "vendor", "productType", "tags"])
  /// Enabled storefront sort keys (empty + hideSortDropdown = no Sort By UI)
  sortOptionsEnabled String[] @default(["manual", "title_asc", "title_desc", "price_asc", "price_desc", "date_desc", "date_asc"])
  /// Default sort key; "manual" follows Shopify collection order after sync
  defaultSort        String   @default("manual")
  hideSortDropdown   Boolean  @default(false)
  /// Pin available products before C4 secondary sort
  inStockOnTop       Boolean  @default(false)
  /// Push unavailable products after C4 secondary sort
  soldOutToBottom    Boolean  @default(false)
  /// Globo: search bar on collection pages (keyword stays inside the collection)
  enableCollectionSearch Boolean @default(false)
  /// C9: show pinned products/collections on empty search focus
  showSuggestionsOnEmptyQuery Boolean @default(false)
  /// C9: show pinned products/collections when a query matches nothing
  showSuggestionsOnNoResults Boolean @default(false)
  suggestionProductHandles String[] @default([])
  suggestionCollectionHandles String[] @default([])
  updatedAt         DateTime @updatedAt
}

/// Per-collection filter toggles + display order.
model FilterConfig {
  id                  String   @id @default(cuid())
  shopId              String
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  /// Shopify collection GID; use empty string for shop-wide default
  collectionGid       String   @default("")
  enabled             Boolean  @default(true)
  enablePrice         Boolean  @default(true)
  /// % off slider from variant compare-at vs price (C15); off by default
  enableSale          Boolean  @default(false)
  enableAvailability  Boolean  @default(true)
  enableVendor        Boolean  @default(true)
  enableProductType   Boolean  @default(true)
  enableTags          Boolean  @default(true)
  enableOptions       Boolean  @default(true)
  /// auto = min/max from synced collection products; custom = merchant-defined bounds
  priceRangeMode      String   @default("auto")
  customPriceMin      Decimal? @db.Decimal(12, 2)
  customPriceMax      Decimal? @db.Decimal(12, 2)
  /// Ordered filter keys, e.g. ["availability","price","sale","vendor","productType","tags","options"]
  displayOrder        String[] @default(["availability", "price", "sale", "vendor", "productType", "tags", "options"])
  /// Per-facet UI: vendor -> checkbox, productType -> dropdown, options -> swatch, price -> slider, …
  displayTypes        Json     @default("{}")
  /// Per-facet value combine: tags/options/mf_* -> "and" | "or" (default OR)
  matchModes          Json     @default("{}")
  /// Per-facet value order: { "vendor": { "mode": "alpha"|"manual"|"auto", "values": ["Acme"] } }
  valueSort           Json     @default("{}")
  /// Per RANGE metafield slider bounds: { "mf_custom_length": { "mode": "custom", "min": 0, "max": 100 } }
  rangeBounds         Json     @default("{}")
  updatedAt           DateTime @updatedAt

  @@unique([shopId, collectionGid])
  @@index([shopId])
}

/// Merchant-selected metafields that become storefront filters.
model MetafieldMapping {
  id           String              @id @default(cuid())
  shopId       String
  shop         Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  namespace    String
  key          String
  displayLabel String
  filterType   MetafieldFilterType @default(LIST)
  /// PRODUCT = product metafield; VARIANT = any-variant match
  ownerType    MetafieldOwnerType  @default(PRODUCT)
  enabled      Boolean             @default(true)
  sortOrder    Int                 @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([shopId, namespace, key, ownerType])
  @@index([shopId])
}

/// Sync status tracker per shop (one row per tenant).
model SyncJob {
  id                    String     @id @default(cuid())
  shopId                String     @unique
  shop                  Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  lastFullSyncAt        DateTime?
  lastIncrementalSyncAt DateTime?
  status                SyncStatus @default(PENDING)
  errorLog              String?
  bulkOperationId       String?
  updatedAt             DateTime   @updatedAt
}

/// Billing mirror + plan limits.
model Subscription {
  id                    String    @id @default(cuid())
  shopId                String    @unique
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  planName              String
  status                String
  shopifySubscriptionId String?
  productLimit          Int       @default(5000)
  filterLimit           Int       @default(25)
  test                  Boolean   @default(false)
  trialEndsAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

/// Denormalized product row for collection filter queries.
model ProductFacet {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productGid  String
  handle      String
  title       String
  vendor      String   @default("")
  productType String   @default("")
  tags        String[]
  skus        String[] @default([])
  options     Json     @default("{}")
  priceMin    Decimal  @db.Decimal(12, 2)
  priceMax    Decimal  @db.Decimal(12, 2)
  /// Min/max variant compare-at; null when no variant has a compare-at
  compareAtMin Decimal? @db.Decimal(12, 2)
  compareAtMax Decimal? @db.Decimal(12, 2)
  /// Max variant-level % off: (compareAt - price) / compareAt * 100 when compareAt > price
  salePct     Decimal  @default(0) @db.Decimal(5, 2)
  available   Boolean  @default(true)
  /// Shopify product status: ACTIVE | DRAFT | ARCHIVED
  status      String   @default("ACTIVE")
  imageUrl    String?
  /// Per-variant images: [{ options: { Color: "Red" }, imageUrl: "https://..." }]
  variantImages Json     @default("[]")
  metafields  Json     @default("{}")
  /// Union of variant metafield values: { "namespace.key": "value" | JSON array }
  variantMetafields Json @default("{}")
  /// Shopify publishedAt (fallback createdAt) for date sort
  publishedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([shopId, productGid])
  @@index([shopId, vendor])
  @@index([shopId, productType])
  @@index([shopId, available])
}

model CollectionMembership {
  id            String @id @default(cuid())
  shopId        String
  shop          Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionGid String
  productGid    String
  /// Shopify collection product order (0-based)
  position      Int    @default(0)

  @@unique([shopId, collectionGid, productGid])
  @@index([shopId, collectionGid])
}

/// Synced collection list for admin UI / filter config.
model Collection {
  id            String   @id @default(cuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  collectionGid String
  title         String
  handle        String   @default("")
  updatedAt     DateTime @updatedAt

  @@unique([shopId, collectionGid])
  @@index([shopId])
}

/// Metafield keys discovered during catalog sync (for mapping UI).
model DiscoveredMetafield {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  namespace   String
  key         String
  /// PRODUCT vs VARIANT discovery (same ns.key can exist on both)
  ownerType   MetafieldOwnerType @default(PRODUCT)
  sampleValue String?
  updatedAt   DateTime @updatedAt

  @@unique([shopId, namespace, key, ownerType])
  @@index([shopId])
}

/// GDPR / compliance webhook audit log (shop-scoped by domain; survives purge).
model ComplianceRequest {
  id         String   @id @default(cuid())
  shopDomain String
  topic      String
  payload    Json
  createdAt  DateTime @default(now())

  @@index([shopDomain])
}
